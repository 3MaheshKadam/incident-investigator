# The monitored app: four small services in one image. Standard library only, so no pip install.
FROM python:3.11-slim
WORKDIR /app
COPY target target
RUN useradd --create-home --uid 10001 app && mkdir -p /data && chown app:app /data
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1 BIND_HOST=0.0.0.0 DB_PATH=/data/shop.sqlite FLAGS_PATH=/data/flags.json
VOLUME /data
USER app
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=3 \
  CMD python -c "import os, urllib.request as u; u.urlopen('http://127.0.0.1:%s/health' % os.environ['PORT'], timeout=2)"
CMD ["python", "-m", "target.services", "api-gateway"]
