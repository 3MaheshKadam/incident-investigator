# Copy to .env and fill in. Never commit .env.
# Which model backend to use: mock | ollama | openai_compat
LLM_PROVIDER=mock
LLM_MODEL=llama3.1:8b
# Ollama (local development)
OLLAMA_BASE_URL=http://localhost:11434
# Context window in tokens. Ollama's default is small and cuts off long tool output.
OLLAMA_NUM_CTX=8192
# Hosted model via an OpenAI-compatible API (final runs)
LLM_BASE_URL=
LLM_API_KEY=
# Free tiers allow few requests per minute. 2.5 seconds between calls stays under 30/minute.
LLM_MIN_INTERVAL=0
LLM_MAX_RETRIES=5
# Example free option (Groq): LLM_PROVIDER=openai_compat
#   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
# Safety limits for every run
MAX_STEPS=12
MAX_OUTPUT_TOKENS=1024
# Deployed stack (docker-compose.yml)
APP_VERSION=v1.0.0
STACK_ROWS=200000
# Set to 1 and run `docker compose up -d --no-deps orders-service` to ship the buggy release
ORDERS_BUG=0
